# ---- Core ----
DATABASE_URL=postgres://reelscript@localhost:5433/reelscript
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# all | api | worker  (run api and worker as separate processes in production)
ROLE=all
DATA_DIR=./data

# ---- Profile discovery ----
# none | meta_business_discovery | apify_reel_scraper
# Instagram blocks logged-out profile listing, so with "none" only reelUrls imports work.
DISCOVERY_PROVIDER=none

# Official + free. Needs your own IG Business/Creator account linked to a Facebook Page.
# Token scopes: instagram_basic, pages_read_engagement, instagram_manage_insights
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# Paid hosted scraper (opt-in). Review Apify's and Instagram's terms before enabling.
APIFY_TOKEN=
APIFY_REEL_SCRAPER_ACTOR=apify~instagram-reel-scraper
APIFY_REEL_SCRAPER_USD_PER_1000=2.6

# ---- Per-reel metadata + audio ----
# yt_dlp (free, local, logged-out) | apify_audio (hosted, needs APIFY_TOKEN)
MEDIA_PROVIDER=yt_dlp
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Polite pacing between Instagram requests from one worker
MEDIA_MIN_INTERVAL_MS=4000
MEDIA_CONCURRENCY=1
APIFY_AUDIO_ACTOR=maximedupre~instagram-reels-audio-downloader
APIFY_AUDIO_USD_PER_1000=0.01

# ---- Transcription ----
# whisper_cpp (free, local) | openai_compatible (OpenAI, Groq, self-hosted)
TRANSCRIPTION_PROVIDER=whisper_cpp
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH=./models/ggml-large-v3-turbo-q5_0.bin
WHISPER_VAD_MODEL_PATH=./models/ggml-silero-v5.1.2.bin
WHISPER_THREADS=4
WHISPER_LANGUAGE=auto
TRANSCRIPTION_CONCURRENCY=2

OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=whisper-1
OPENAI_COMPAT_USD_PER_MINUTE=0.006

METRICS_STALE_AFTER_HOURS=72
KEEP_AUDIO_FILES=true
RETRY_DELAY_SECONDS=30
